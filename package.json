{
  "name": "vscode-extension-simple-rdb",
  "displayName": "Simple RDB",
  "description": "Simple MySQL database management for VS Code — VSCode에서 MySQL 데이터베이스를 손쉽게 관리하는 확장",
  "version": "0.0.2",
  "publisher": "hail-kang",
  "license": "MIT",
  "engines": {
    "vscode": "^1.80.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hail-kang/vscode-extension-simple-rdb.git"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "mysql",
    "database",
    "sql",
    "db",
    "rdb",
    "query"
  ],
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simple-rdb",
          "title": "Simple RDB",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "simple-rdb": [
        {
          "id": "simple-rdb-connections",
          "name": "Connections"
        }
      ]
    },
    "commands": [
      {
        "command": "simple-rdb.addConnection",
        "title": "Add Connection",
        "icon": "$(add)",
        "category": "Simple RDB"
      },
      {
        "command": "simple-rdb.editConnection",
        "title": "Edit Connection",
        "category": "Simple RDB"
      },
      {
        "command": "simple-rdb.removeConnection",
        "title": "Remove Connection",
        "category": "Simple RDB"
      },
      {
        "command": "simple-rdb.connect",
        "title": "Connect",
        "category": "Simple RDB"
      },
      {
        "command": "simple-rdb.disconnect",
        "title": "Disconnect",
        "category": "Simple RDB"
      },
      {
        "command": "simple-rdb.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Simple RDB"
      },
      {
        "command": "simple-rdb.openTable",
        "title": "Open Table",
        "category": "Simple RDB"
      },
      {
        "command": "simple-rdb.newSqlFile",
        "title": "New SQL File",
        "icon": "$(new-file)",
        "category": "Simple RDB"
      },
      {
        "command": "simple-rdb.openSqlFile",
        "title": "Open SQL File",
        "category": "Simple RDB"
      },
      {
        "command": "simple-rdb.deleteSqlFile",
        "title": "Delete SQL File",
        "category": "Simple RDB"
      },
      {
        "command": "simple-rdb.runSqlFile",
        "title": "Run SQL File",
        "category": "Simple RDB"
      },
      {
        "command": "simple-rdb.runQuery",
        "title": "Run SQL Query",
        "category": "Simple RDB"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "simple-rdb.addConnection",
          "when": "view == simple-rdb-connections",
          "group": "navigation"
        },
        {
          "command": "simple-rdb.refresh",
          "when": "view == simple-rdb-connections",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "simple-rdb.connect",
          "when": "view == simple-rdb-connections && viewItem == connection",
          "group": "inline"
        },
        {
          "command": "simple-rdb.disconnect",
          "when": "view == simple-rdb-connections && viewItem == connected",
          "group": "inline"
        },
        {
          "command": "simple-rdb.editConnection",
          "when": "view == simple-rdb-connections && viewItem =~ /^(?:connection|connected)$/"
        },
        {
          "command": "simple-rdb.removeConnection",
          "when": "view == simple-rdb-connections && viewItem =~ /^(?:connection|connected)$/"
        },
        {
          "command": "simple-rdb.newSqlFile",
          "when": "view == simple-rdb-connections && viewItem =~ /^(?:connection|connected)$/"
        },
        {
          "command": "simple-rdb.openTable",
          "when": "view == simple-rdb-connections && viewItem == table"
        },
        {
          "command": "simple-rdb.newSqlFile",
          "when": "view == simple-rdb-connections && viewItem == sqlFileGroup",
          "group": "inline"
        },
        {
          "command": "simple-rdb.openSqlFile",
          "when": "view == simple-rdb-connections && viewItem == sqlFile"
        },
        {
          "command": "simple-rdb.runSqlFile",
          "when": "view == simple-rdb-connections && viewItem == sqlFile"
        },
        {
          "command": "simple-rdb.deleteSqlFile",
          "when": "view == simple-rdb-connections && viewItem == sqlFile"
        }
      ],
      "commandPalette": [
        {
          "command": "simple-rdb.connect",
          "when": "false"
        },
        {
          "command": "simple-rdb.disconnect",
          "when": "false"
        },
        {
          "command": "simple-rdb.editConnection",
          "when": "false"
        },
        {
          "command": "simple-rdb.removeConnection",
          "when": "false"
        },
        {
          "command": "simple-rdb.openTable",
          "when": "false"
        },
        {
          "command": "simple-rdb.openSqlFile",
          "when": "false"
        },
        {
          "command": "simple-rdb.deleteSqlFile",
          "when": "false"
        },
        {
          "command": "simple-rdb.runSqlFile",
          "when": "false"
        },
        {
          "command": "simple-rdb.runQuery",
          "when": "editorLangId == sql"
        }
      ]
    },
    "keybindings": [
      {
        "command": "simple-rdb.runQuery",
        "key": "cmd+enter",
        "when": "editorLangId == sql && simpleRdb.isManagedSqlFile"
      },
      {
        "command": "simple-rdb.runQuery",
        "key": "ctrl+enter",
        "when": "editorLangId == sql && simpleRdb.isManagedSqlFile"
      }
    ],
    "viewsWelcome": [
      {
        "view": "simple-rdb-connections",
        "contents": "아직 등록된 데이터베이스 연결이 없습니다.\n[Add Connection](command:simple-rdb.addConnection)"
      }
    ],
    "configuration": {
      "title": "Simple RDB",
      "properties": {
        "simpleRdb.pageSize": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "테이블 뷰에서 한 페이지에 불러올 행 수"
        },
        "simpleRdb.defaultLimit": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "description": "LIMIT이 없는 SELECT에 자동으로 적용할 최대 행 수 (0이면 비활성화)"
        },
        "simpleRdb.maxBulkDelete": {
          "type": "number",
          "default": 100,
          "minimum": 1,
          "description": "한 번에 삭제할 수 있는 최대 행 수"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run check-types && npm run bundle",
    "compile": "tsc -p ./",
    "bundle": "node esbuild.mjs --production",
    "check-types": "tsc --noEmit -p ./",
    "watch": "node esbuild.mjs --watch",
    "lint": "eslint src",
    "test": "npm run compile && node --test \"dist/test/**/*.test.js\"",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "package": "npm run vscode:prepublish && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^3.9.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.39.5",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.64.0"
  },
  "dependencies": {
    "mysql2": "^3.0.0",
    "ssh2": "^1.0.0"
  }
}
